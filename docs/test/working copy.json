  <script>
  (function () {
    const RADIUS = 3;
    const W = 800, H = 600;

    const svg = d3.select("#chart")
      .append("svg")
      .attr("viewBox", `0 0 ${W} ${H}`)
      .attr("preserveAspectRatio", "xMidYMid meet")
      .attr("width", W)
      .attr("height", H);

    const labelG = svg.append("g");
    const data = DATA.map(d => ({ ...d }));

    const circles = svg.selectAll("circle")
      .data(data)
      .join("circle")
      .attr("cx", d => d.p0.x)
      .attr("cy", d => d.p0.y)
      .attr("r", RADIUS)
      .attr("fill", "#888")
      .attr("opacity", 0.85);

    function clearLabels() { labelG.selectAll("*").remove(); }

    function addLabel(text, x, y) {
      labelG.append("text")
        .attr("x", x).attr("y", y)
        .attr("text-anchor", "middle")
        .attr("font-family", "Barlow, sans-serif")
        .attr("font-size", "12px")
        .attr("fill", "#555")
        .text(text)
        .attr("opacity", 0)
        .transition().duration(600).delay(1200)
        .attr("opacity", 1);
    }

    function toSlide0() {
      clearLabels();
      circles.transition().duration(1500)
        .attr("cx", d => d.p0.x).attr("cy", d => d.p0.y)
        .attr("fill", "#888").attr("opacity", 0.85);
    }

    function toSlide1() {
      clearLabels();
      circles.transition().duration(1500)
        .attr("cx", d => d.p1.x).attr("cy", d => d.p1.y)
        .attr("fill", d => d.booked_again ? "#e05c47" : "#888")
        .attr("opacity", 0.85)
        .on("end", (d, i, nodes) => {
          if (i === nodes.length - 1) {
            addLabel("Booked again",     W*0.35, 30);
            addLabel("Not booked again", W*0.65, 30);
          }
        });
    }

    function toSlide2() {
      clearLabels();
      circles.transition().duration(1500)
        .attr("cx", d => d.p2.x).attr("cy", d => d.p2.y)
        .attr("fill", d => (d.booked_again && d.drug) ? "#e05c47" : "#888")
        .attr("opacity", d => d.booked_again ? 0.9 : 0.2)
        .on("end", (d, i, nodes) => {
          if (i === nodes.length - 1) {
            addLabel("Booked again + drug",   W*0.25, 30);
            addLabel("Booked again, no drug", W*0.45, 30);
            addLabel("Not booked again",      W*0.75, 30);
          }
        });
    }

    function toSlide3() {
      clearLabels();
      circles.transition().duration(1500)
        .attr("cx", d => d.p3.x).attr("cy", d => d.p3.y)
        .attr("fill", "#e05c47")
        .attr("opacity", d => (d.booked_again && d.drug) ? 0.9 : 0)
        .on("end", (d, i, nodes) => {
          if (i === nodes.length - 1) {
            addLabel("Booked again + drug charge", W/2, 30);
          }
        });
    }

    const scroller = scrollama();
    scroller.setup({
      step: "#scrolly article .step",
      offset: 0.75,
      debug: false,
    })
    .onStepEnter(({ element }) => {
      document.querySelectorAll(".step").forEach(s => s.classList.remove("is-active"));
      element.classList.add("is-active");
      const id = element.id;
      if (id === "step-0") toSlide0();
      if (id === "step-1") toSlide1();
      if (id === "step-2") toSlide2();
      if (id === "step-3") toSlide3();
    });

    window.addEventListener("resize", scroller.resize);
  })();
  </script>
</body>
</html>