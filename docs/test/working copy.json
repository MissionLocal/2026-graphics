  <style>
    body { margin: 0px; font-family: Barlow, sans-serif; }
    .site-content { overflow: visible !important; }
    .stop-flickering { -webkit-transform: translate3d(0, 0, 0); }
    #mainScrolly { padding-top: 2rem; }
    #scrolly { position: relative; }
    article {
      position: relative;
      padding: 0;
      max-width: 30rem;
      margin: 0 auto;
      padding-bottom: 10rem;
      z-index: 25;
    }
    .sticky-thing {
      position: -webkit-sticky;
      position: sticky;
      top: 15vh;
      height: 90vh;
      left: 0;
      width: 100%;
      margin: 0;
      z-index: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      -webkit-transform: translate3d(0, 0, 0);
    }
    @media (max-width: 768px) { .sticky-thing { top: 5vh; } }
    #chart { width: 100%; max-width: 800px; }
    #chart svg { width: 100%; height: auto; }
    .step {
      color: #1b1b1b;
      background-color: #fafafaef;
      font-family: Barlow, sans-serif;
      padding: 5px 15px;
      line-height: 25px;
      font-size: 15px;
      margin-bottom: 100vh;
    }
    .step:last-child { margin-bottom: 0; }
    .step.is-active { background-color: #fafafaef; }
    .step p { padding: 0rem 1rem; font-size: 1rem; }
    .highlight { background-color: #000000a7; color: white; padding: 3px; }
    @media (max-width: 600px) {
      article { margin: 0; padding-top: 65vh; }
      .step { margin-bottom: 100vh; width: 80vw; margin-left: auto; margin-right: auto; }
    }
  </style>
</head>
